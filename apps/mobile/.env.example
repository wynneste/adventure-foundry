# Copy to .env and fill in from Supabase → Project Settings → API.
# These are safe to ship in the app: RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only needed for the Android map (iOS uses Apple Maps).
GOOGLE_MAPS_ANDROID_API_KEY=
# Your community Discord invite, shown in chats.
EXPO_PUBLIC_COMMUNITY_DISCORD_URL=https://discord.gg/your-invite
